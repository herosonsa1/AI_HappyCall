# ============================================================================
# [Speech AI 노드 환경변수] Faster-Whisper + CosyVoice 2.0 + Silero VAD v5
# Mac Studio M5 Pro 클러스터 또는 Linux GPU 노드 공용 환경 설정
# ============================================================================

SPEECH_NODE_ID=SPEECH-NODE-01
SPEECH_BIND_HOST=0.0.0.0
SPEECH_BIND_PORT=8100

# 1. Faster-Whisper STT 설정 (폐쇄망 로컬 모델 경로)
STT_MODEL_PATH=/opt/ai_models/faster-whisper-large-v3-turbo
STT_COMPUTE_TYPE=float16
STT_BEAM_SIZE=3
STT_LANGUAGE=ko
STT_DOMAIN_HOTWORDS=해피콜,완전판매,개인정보수집동의,민감정보동의,자동이체,청약철회,본인확인,생년월일

# 2. Silero VAD v5 및 Barge-in (끼어들기 감지) 파라미터
VAD_THRESHOLD=0.52
VAD_MIN_SPEECH_DURATION_MS=180
VAD_MIN_SILENCE_DURATION_MS=420
VAD_SPEECH_PAD_MS=120
BARGE_IN_TRIGGER_MS=180
TTS_DUCKING_HOLD_MS=150

# 3. CosyVoice 2.0 Streaming TTS 설정
TTS_MODEL_PATH=/opt/ai_models/CosyVoice2-0.5B-KO
TTS_SPEAKER_PROFILE=enterprise_female_calm_v2
TTS_SAMPLE_RATE=16000
TTS_CHUNK_SIZE_MS=20
